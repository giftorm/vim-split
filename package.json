{
  "name": "vim-split",
  "displayName": "Vim Split",
  "description": "Vim-style Ctrl+h/j/k/l: focus the editor group in that direction, or split if there is none.",
  "version": "0.1.2",
  "publisher": "giftorm",
  "repository": "https://github.com/giftorm/vim-split",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Keymaps"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "vimSplit.left",
        "title": "Vim Split: Focus or Split Left"
      },
      {
        "command": "vimSplit.down",
        "title": "Vim Split: Focus or Split Down"
      },
      {
        "command": "vimSplit.up",
        "title": "Vim Split: Focus or Split Up"
      },
      {
        "command": "vimSplit.right",
        "title": "Vim Split: Focus or Split Right"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+h",
        "command": "vimSplit.left",
        "when": "(editorFocus || activeEditorGroupEmpty && !sideBarFocus && !panelFocus && !auxiliaryBarFocus) && vim.mode != 'Insert'"
      },
      {
        "key": "ctrl+j",
        "command": "vimSplit.down",
        "when": "(editorFocus || activeEditorGroupEmpty && !sideBarFocus && !panelFocus && !auxiliaryBarFocus) && vim.mode != 'Insert'"
      },
      {
        "key": "ctrl+k",
        "command": "vimSplit.up",
        "when": "(editorFocus || activeEditorGroupEmpty && !sideBarFocus && !panelFocus && !auxiliaryBarFocus) && vim.mode != 'Insert'"
      },
      {
        "key": "ctrl+l",
        "command": "vimSplit.right",
        "when": "(editorFocus || activeEditorGroupEmpty && !sideBarFocus && !panelFocus && !auxiliaryBarFocus) && vim.mode != 'Insert'"
      }
    ]
  }
}
